{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "php": "php artisan",
        "key": "npm run php key:generate",
        "serve": "npm run php serve",
        "migrate": "npm run php migrate",
        "watch": "concurrently \"npm run dev\" \"npm run serve\"",
        "log": "tail -f storage/logs/laravel.log",
        "clear": "php artisan config:clear && php artisan route:clear && php artisan cache:clear"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
